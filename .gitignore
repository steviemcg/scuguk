# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.vs/

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Public files added during build
/public/data
# Local Netlify folder
.netlify

# Claude Code — worktrees and session scratch (the rest of .claude/ is tracked)
/.claude/worktrees/
/.remember/

# Payload local media fallback (used only when BLOB_READ_WRITE_TOKEN is unset)
/media/
