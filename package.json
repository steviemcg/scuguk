{
  "name": "scuguk",
  "description": "Sitecore User Group UK",
  "version": "3.0.0",
  "repository": "https://github.com/steviemcg/scuguk",
  "keywords": [
    "Sitecore",
    "User",
    "Group",
    "UK"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "prebuild": "concurrently \"npm:prebuild:*\"",
    "prebuild:locations": "copyfiles -f \"./src/data/locations/*.+(jpg)\" ./public/data/locations",
    "prebuild:sponsors": "copyfiles -f \"./src/data/sponsors/*.+(png|svg)\" ./public/data/sponsors",
    "prebuild:speakers": "copyfiles -f \"./src/data/speakers/*.+(webp|jpg|png)\" ./public/data/speakers",
    "prebuild:events": "copyfiles -f \"./src/data/events/*.+(jpg)\" ./public/data/events",
    "payload": "payload",
    "payload:generate:types": "payload generate:types",
    "payload:generate:importmap": "payload generate:importmap",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.0.0",
    "@payloadcms/db-postgres": "3.83.0",
    "@payloadcms/next": "3.83.0",
    "@payloadcms/richtext-lexical": "3.83.0",
    "@payloadcms/storage-vercel-blob": "3.83.0",
    "bootstrap": "^5.3.3",
    "calendar-link": "^2.4.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "graphql": "^16.13.2",
    "markdown-to-jsx": "^7.7.0",
    "next": "16.2.4",
    "payload": "3.83.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sharp": "^0.34.5",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@next/eslint-plugin-next": "16.2.4",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.1.2",
    "copyfiles": "^2.4.1",
    "eslint": "^9.20.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@swc/core",
      "unrs-resolver"
    ]
  }
}
