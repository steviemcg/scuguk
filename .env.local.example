# Copy to .env.local and fill in. .env*.local is gitignored.

# --- Payload -----------------------------------------------------------------
# 32+ random characters. Signs Payload's JWTs and CSRF tokens; changing it logs
# everyone out of /admin.
PAYLOAD_SECRET=replace-me-with-32-plus-random-chars

# --- Database (Neon Postgres — decision D2) ----------------------------------
# Provisioned through the Vercel Marketplace; `vercel env pull .env.local` fills
# this in once the project is linked. Any Postgres works for local dev.
DATABASE_URL=postgres://user:pass@ep-example.eu-west-2.aws.neon.tech/scuguk?sslmode=require

# --- Media (Vercel Blob) -----------------------------------------------------
# OPTIONAL locally. Leave it unset and uploads go to local disk instead — see the
# comment in src/payload.config.ts. Injected automatically on Vercel.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:8000
